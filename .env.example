# =================================================================
# Antigravity Web Search Agent - Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. LLM PROVIDERS (Provide AT LEAST ONE key)
# -----------------------------------------------------------------

# Google Gemini (Default recommended - Fast, large context window)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (Alternative: GPT-4o, GPT-4o-mini)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude (Alternative: Claude 3.5 Sonnet)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq (Alternative: Ultra-fast open models)
# Get key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI-Compatible Base URL (For Ollama, DeepSeek, OpenRouter, vLLM)
# OPENAI_BASE_URL=http://localhost:11434/v1

# -----------------------------------------------------------------
# 2. WEB SEARCH PROVIDERS (Optional - DuckDuckGo is zero-config fallback)
# -----------------------------------------------------------------

# Tavily AI Search (Recommended for AI agents: clean text & published dates)
# Get free key at: https://tavily.com
TAVILY_API_KEY=

# Brave Search API (Alternative: fast privacy-focused web search)
# Get free key at: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Serper Google Search API (Alternative: Google organic results)
# Get free key at: https://serper.dev
SERPER_API_KEY=

# -----------------------------------------------------------------
# 3. SERVER & TESTING CONFIGURATION
# -----------------------------------------------------------------
PORT=3000

# Set to true for fully offline deterministic mock search tests
USE_MOCK_SEARCH=false

