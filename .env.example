# LLM Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Web Search Provider Configuration
# Options: "tavily" | "brave" | "mock" (default: "tavily")
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# Persistence Storage Path
STORAGE_PATH=./data/agent_memory.json

# Server & Security Hardening
PORT=3000
NODE_ENV=production
# Minimum 32 random chars (e.g. openssl rand -hex 32). Required in production to persist sessions across restarts.
SESSION_SECRET=
# Optional 32-byte key (64 hex chars or base64) to enable AES-256-GCM encryption at rest for data stores.
DATA_ENCRYPTION_KEY=
# Comma-separated explicit origins (no "*") allowed via CORS with credentials. Same-origin is always allowed.
CORS_ALLOWED_ORIGINS=
# Set to true only when running behind a TLS-terminating reverse proxy.
TRUST_PROXY=false
# Set to true when serving over HTTPS so session cookies enforce the Secure attribute.
COOKIE_SECURE=false
# Allow standard non-admin signups (POST /api/auth/register) after initial admin setup.
ALLOW_REGISTRATION=true
# Optional headless initial admin provisioning (used only if no admin account exists yet).
ADMIN_USERNAME=
ADMIN_PASSWORD=
